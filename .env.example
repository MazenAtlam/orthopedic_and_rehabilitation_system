# =============================================================================
# Orthopedic and Rehabilitation System - environment variables (Team 03)
# Copy this file to ".env" and change the values marked CHANGE_ME.
#   Linux / macOS : cp .env.example .env
#   Windows (PS)  : Copy-Item .env.example .env
# NEVER commit the real ".env" file. Only ".env.example" goes to Git.
# =============================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=hcis_user
# avoid the characters @ : / # in the password
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=hcis_db
# port opened on your computer
DB_HOST_PORT=5432

# Used only when the backend runs OUTSIDE Docker (host "localhost").
# Inside Docker Compose this value is built automatically with host "db".
DATABASE_URL=postgresql+psycopg2://hcis_user:CHANGE_ME_db_password@localhost:5432/hcis_db

# ---------- Backend (Flask) ----------
# development | testing | production
APP_ENV=development
# Generate each secret with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_flask_secret_key_at_least_32_bytes
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_key_at_least_32_bytes
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174
# Enable fictional data and the demo-token CLI only for local development.
DEMO_MODE=1
# Automatically seed when DEMO_MODE=1 and APP_ENV is not production.
SEED_ON_START=true

# ---------- Frontend and EMR client (Vite) ----------
VITE_API_BASE_URL=http://localhost/api/v1
# needed for hot reload on Windows / WSL
CHOKIDAR_USEPOLLING=true

# ---------- Phase 3 only: imaging profile (Orthanc + CDSS) ----------
ORTHANC_URL=http://orthanc:8042
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=CHANGE_ME_orthanc_password
CDSS_URL=http://cdss-service:8000
CDSS_MODEL_PATH=/app/models/model.pt
